DATABASE_URL="postgresql://postgres:password@localhost:5432/booking_court"
JWT_SECRET="replace-with-a-random-secret-at-least-16-characters"
FRONTEND_URL="http://localhost:5173"

# VNPay credentials are backend-only. Never put the hash secret into VITE_* variables.
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""
VNPAY_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_RETURN_URL="http://localhost:3000/api/payments/vnpay/return"
# Enable only behind a trusted reverse proxy (e.g. your hosting platform).
TRUST_PROXY="false"

# Production password-recovery email (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Lên Kèo Thôi <no-reply@your-domain.com>"

# Backend only. Use a random secret of at least 32 characters for a scheduler
# calling GET /api/cron/match-reminders with Authorization: Bearer <CRON_SECRET>.
# CRON_SECRET=""
